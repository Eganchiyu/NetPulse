{
  "name": "lstm_seq_observatory",
  "nodes": [
    {
      "id": "seq_src",
      "type": "seq_wave_data",
      "params": {
        "task": "memory_cue",
        "seq_len": 28,
        "feat_dim": 4,
        "num_classes": 3,
        "num_samples": 600,
        "variable_length": true,
        "noise": 0.12
      }
    },
    {
      "id": "lstm",
      "type": "lstm",
      "params": {
        "hidden_size": 32,
        "num_layers": 1,
        "forget_bias": 1.0,
        "init": "orthogonal"
      }
    },
    {
      "id": "pool",
      "type": "seq_pool",
      "params": {
        "mode": "last"
      }
    },
    {
      "id": "head",
      "type": "mlp_block",
      "params": {
        "dims": [32, 3],
        "activation": "relu"
      }
    },
    {
      "id": "ce",
      "type": "cross_entropy_loss",
      "params": {}
    },
    {
      "id": "probe_gates",
      "type": "gate_dynamics",
      "params": {
        "sample_idx": 0,
        "max_steps": 64,
        "saturation_thresh": 0.1
      }
    },
    {
      "id": "probe_traj",
      "type": "hidden_trajectory",
      "params": {
        "method": "pca",
        "sample_idx": 0,
        "max_points": 64
      }
    },
    {
      "id": "probe_energy",
      "type": "step_energy",
      "params": {
        "sample_idx": 0,
        "max_steps": 64,
        "norm_mode": "l2"
      }
    }
  ],
  "edges": [
    { "id": "e_seq_in", "src_node": "seq_src", "src_port": "x", "dst_node": "lstm", "dst_port": "x" },
    { "id": "e_pool", "src_node": "lstm", "src_port": "out", "dst_node": "pool", "dst_port": "x" },
    { "id": "e_head", "src_node": "pool", "src_port": "out", "dst_node": "head", "dst_port": "x" },
    { "id": "e_logits", "src_node": "head", "src_port": "out", "dst_node": "ce", "dst_port": "logits" },
    { "id": "e_target", "src_node": "seq_src", "src_port": "y", "dst_node": "ce", "dst_port": "target" },
    { "id": "e_tap_i", "src_node": "lstm", "src_port": "gate_i", "dst_node": "probe_gates", "dst_port": "i", "edge_kind": "tap" },
    { "id": "e_tap_f", "src_node": "lstm", "src_port": "gate_f", "dst_node": "probe_gates", "dst_port": "f", "edge_kind": "tap" },
    { "id": "e_tap_o", "src_node": "lstm", "src_port": "gate_o", "dst_node": "probe_gates", "dst_port": "o", "edge_kind": "tap" },
    { "id": "e_tap_c", "src_node": "lstm", "src_port": "cell_state", "dst_node": "probe_gates", "dst_port": "c", "edge_kind": "tap" },
    { "id": "e_tap_h", "src_node": "lstm", "src_port": "hidden_states", "dst_node": "probe_traj", "dst_port": "x", "edge_kind": "tap" },
    { "id": "e_energy", "src_node": "lstm", "src_port": "out", "dst_node": "probe_energy", "dst_port": "x" }
  ],
  "losses": [
    { "node_id": "ce", "weight": 1.0 }
  ],
  "trainer": {
    "optimizer": "adam",
    "lr": 0.005,
    "batch_size": 32,
    "epochs": 8
  }
}
